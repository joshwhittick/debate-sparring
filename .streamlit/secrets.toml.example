# Streamlit Community Cloud: paste these into the app's Secrets box (or copy to .streamlit/secrets.toml locally).
# Root-level keys are copied into the environment, so they work like .env values.
GEMINI_API_KEY = ""
GEMINI_MODEL = "gemini-3.1-flash-lite"
GEMINI_TIER = "free"
VOICE_ON_FREE_TIER = ""
# Required on Cloud: the app refuses to run without it. Use a random 20+ character value.
APP_PASSWORD = ""
# USD per UTC day across all visitors; no new Gemini calls once reached.
DAILY_SPEND_LIMIT_USD = "1.0"
