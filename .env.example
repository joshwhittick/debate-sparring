GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# free | paid. Speak mode stays off unless paid AND the key belongs to a billed project.
GEMINI_TIER=free
# Free tier only: 1 enables voice anyway (Google may use and human-review recordings).
VOICE_ON_FREE_TIER=
# gemini (default; audio goes to Google, adds delivery notes) | whisper (local faster-whisper; audio stays here,
# Speak mode works on the free tier with no opt-in). WHISPER_MODEL defaults to small.en; base.en is faster, rougher.
TRANSCRIBER=
WHISPER_MODEL=
# Streamlit web deploy only: the app asks for this password first. Leave blank locally.
APP_PASSWORD=
# Streamlit: public mode is automatic off localhost. 1 forces it on locally, 0 off (not on Streamlit Cloud).
PUBLIC_DEPLOY=
# USD per UTC day; no new Gemini calls once reached (default 1.0).
DAILY_SPEND_LIMIT_USD=
